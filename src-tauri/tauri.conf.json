{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relics",
  "version": "0.1.0",
  "identifier": "local.relics.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Relics · Sanctuary", "width": 1000, "height": 800 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:" }
  },
  "bundle": { "active": false },
  "plugins": { "sql": { "preload": ["sqlite:relics.db"] } }
}
